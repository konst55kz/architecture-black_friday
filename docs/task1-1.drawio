<mxfile host="app.diagrams.net">
  <diagram name="1. Шардирование MongoDB" id="step1-sharding">
    <mxGraphModel dx="1238" dy="823" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" value="&lt;b&gt;Шаг 1. Шардирование MongoDB (2 шарда)&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="600" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="cluster" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;rounded=1;dashed=1;" value="MongoDB sharded cluster" vertex="1">
          <mxGeometry height="520" width="560" x="300" y="90" as="geometry" />
        </mxCell>
        <mxCell id="mongos" parent="cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;mongos_router&lt;/b&gt;&lt;br&gt;маршрутизатор запросов&lt;br&gt;:27020" vertex="1">
          <mxGeometry height="70" width="160" x="40" y="225" as="geometry" />
        </mxCell>
        <mxCell id="config" parent="cluster" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;configSrv&lt;/b&gt;&lt;br&gt;сервер конфигурации&lt;br&gt;(метаданные, карта чанков)&lt;br&gt;:27017" vertex="1">
          <mxGeometry height="100" width="160" x="40" y="50" as="geometry" />
        </mxCell>
        <mxCell id="shard1" parent="cluster" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;shard1&lt;/b&gt;&lt;br&gt;часть данных коллекции&lt;br&gt;:27018" vertex="1">
          <mxGeometry height="110" width="150" x="360" y="80" as="geometry" />
        </mxCell>
        <mxCell id="shard2" parent="cluster" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;shard2&lt;/b&gt;&lt;br&gt;часть данных коллекции&lt;br&gt;:27019" vertex="1">
          <mxGeometry height="110" width="150" x="360" y="330" as="geometry" />
        </mxCell>
        <mxCell id="e-mongos-config" edge="1" parent="cluster" source="mongos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=10;" target="config" value="читает метаданные&lt;br&gt;о распределении чанков">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-mongos-s1" edge="1" parent="cluster" source="mongos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.25;exitDx=0;exitDy=0;" target="shard1" value="запросы к чанкам shard1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-mongos-s2" edge="1" parent="cluster" source="mongos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.75;exitDx=0;exitDy=0;" target="shard2" value="запросы к чанкам shard2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-config-shards" edge="1" parent="cluster" source="shard2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=1 3;fontSize=10;startArrow=classic;endArrow=classic;strokeColor=#999999;fontColor=#666666;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" target="shard1" value="балансировщик&lt;br&gt;переносит чанки">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="pymongo-api" vertex="1">
          <mxGeometry height="70" width="140" x="60" y="320" as="geometry" />
        </mxCell>
        <mxCell id="e-api-mongos" edge="1" parent="1" source="api" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" target="mongos" value="все запросы&lt;br&gt;MONGODB_URL → mongos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;Как это работает&lt;/b&gt;&lt;br&gt;• Приложение подключается только к mongos и не знает, на каком шарде лежат данные.&lt;br&gt;• Коллекция делится на чанки по хешированному ключу шардирования (например, &lt;i&gt;{ name: &quot;hashed&quot; }&lt;/i&gt;) — данные распределяются между шардами примерно поровну.&lt;br&gt;• mongos по карте чанков из configSrv направляет запрос на нужный шард (или на оба — для запросов без ключа).&lt;br&gt;• Нагрузка на чтение и запись делится между двумя узлами → выше производительность.&lt;br&gt;&lt;br&gt;&lt;i&gt;На этом шаге каждый компонент — один узел; репликация и кеш добавляются на следующих шагах.&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="560" x="300" y="630" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
