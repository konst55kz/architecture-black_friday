        </mxCell>
        <mxCell id="api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="pymongo-api" vertex="1">
          <mxGeometry height="70" width="140" x="60" y="380" as="geometry" />
        </mxCell>
        <mxCell id="am" edge="1" parent="1" source="api" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" target="mongos" value="2. при промахе кеша&lt;br&gt;MONGODB_URL → mongos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;Как это работает&lt;/b&gt;&lt;br&gt;• Шардирование (2 шарда) и репликация (по 3 реплики на шард) из шагов 1–2 сохранены.&lt;br&gt;• Добавлен Redis — кеш в памяти перед MongoDB, схема cache-aside: pymongo-api сначала ищет результат запроса в Redis.&lt;br&gt;• Попадание в кеш: ответ возвращается из памяти за миллисекунды, MongoDB не нагружается.&lt;br&gt;• Промах: запрос идёт через mongos в нужный шард, результат сохраняется в Redis с ограниченным временем жизни (TTL), следующие такие же запросы берутся из кеша.&lt;br&gt;• При записи данных устаревшие ключи удаляются из кеша или истекают по TTL.&lt;br&gt;• Redis не хранит основную копию данных: если он недоступен, приложение работает напрямую с MongoDB, только медленнее." vertex="1">
          <mxGeometry height="210" width="1040" x="300" y="740" as="geometry" />
        </mxCell>
        <mxCell id="redis" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;redis&lt;/b&gt;&lt;br&gt;кеш запросов&lt;br&gt;:6379" vertex="1">
          <mxGeometry height="100" width="120" x="70" y="560" as="geometry" />
        </mxCell>
        <mxCell id="ar" edge="1" parent="1" source="api" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=classic;endArrow=classic;strokeColor=#b85450;fontColor=#b85450;" target="redis" value="1. сначала ищет ответ в кеше&lt;br&gt;3. при промахе кладёт ответ&lt;br&gt;с TTL">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
