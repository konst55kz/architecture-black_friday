        <mxCell id="gw-consul" edge="1" parent="1" source="gw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;strokeColor=#d79b00;fontColor=#d79b00;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" target="consul" value="запрашивает список&lt;br&gt;здоровых инстансов">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="apps-consul" edge="1" parent="1" source="apps" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;strokeColor=#d79b00;fontColor=#d79b00;startArrow=classic;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" target="consul" value="регистрация при старте,&lt;br&gt;health-check, удаление&lt;br&gt;при остановке">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="apps-mongos" edge="1" parent="1" source="apps" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" target="mongos" value="при промахе кеша&lt;br&gt;MONGODB_URL → mongos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="apps-redis" edge="1" parent="1" source="apps" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;startArrow=classic;strokeColor=#b85450;fontColor=#b85450;" target="redis" value="кеш запросов&lt;br&gt;(cache-aside, TTL)">
