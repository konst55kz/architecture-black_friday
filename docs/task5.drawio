        <mxCell id="s23" parent="rs2" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f5f5f5;strokeColor=#82b366;" value="&lt;b&gt;shard2-3&lt;/b&gt;&lt;br&gt;SECONDARY&lt;br&gt;копия данных&lt;br&gt;:27024" vertex="1">
