        <mxCell id="s21" parent="rs2" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;shard2-1&lt;/b&gt;&lt;br&gt;PRIMARY&lt;br&gt;чтение / запись&lt;br&gt;:27019" vertex="1">
