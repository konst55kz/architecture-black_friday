        <mxCell id="r2a" edge="1" parent="rs2" source="s21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#82b366;fontColor=#4d7a3b;" target="s22" value="репликация&lt;br&gt;(oplog)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2b" edge="1" parent="rs2" source="s21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#82b366;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" target="s23" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hb2" parent="rs2" style="text;html=1;fontSize=10;fontColor=#666666;align=center;" value="heartbeat между узлами; при падении PRIMARY оставшиеся реплики выбирают новый PRIMARY" vertex="1">
          <mxGeometry height="26" width="400" x="150" y="218" as="geometry" />
        </mxCell>
        <mxCell id="m2" edge="1" parent="cluster" source="mongos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.75;exitDx=0;exitDy=0;" target="rs2" value="запросы к чанкам shard2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mc" edge="1" parent="cluster" source="mongos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;" target="config" value="читает метаданные&lt;br&gt;о распределении чанков">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;" value="&lt;b&gt;Как это работает&lt;/b&gt;&lt;br&gt;• Приложение pymongo-api запущено в нескольких одинаковых инстансах (N ≥ 2, на схеме — 3); они не хранят состояние, поэтому взаимозаменяемы.&lt;br&gt;• Пользователи обращаются к единой точке входа — API Gateway, который распределяет запросы между инстансами (round-robin).&lt;br&gt;• Каждый инстанс при старте регистрируется в Consul, Consul регулярно проверяет его health-check; упавшие и остановленные инстансы исключаются из каталога.&lt;br&gt;• API Gateway получает из Consul актуальный список здоровых инстансов: новые сразу попадают в балансировку, удалённые — убираются. Обновление можно делать поочерёдно, без простоя.&lt;br&gt;• Все инстансы используют общий Redis и общий шардированный реплицированный кластер MongoDB из шагов 1–3." vertex="1">
          <mxGeometry height="220" width="1040" x="800" y="740" as="geometry" />
        </mxCell>
        <mxCell id="redis" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;redis&lt;/b&gt;&lt;br&gt;кеш запросов&lt;br&gt;:6379" vertex="1">
          <mxGeometry height="100" width="120" x="560" y="700" as="geometry" />
        </mxCell>
        <mxCell id="users" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" value="Пользователи&lt;br&gt;(браузер)" vertex="1">
          <mxGeometry height="70" width="40" x="70" y="390" as="geometry" />
        </mxCell>
        <mxCell id="gw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;балансировщик&lt;br&gt;(round-robin)&lt;br&gt;:80" vertex="1">
          <mxGeometry height="80" width="160" x="220" y="385" as="geometry" />
        </mxCell>
        <mxCell id="apps" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=26;rounded=1;fillColor=#ffffff;strokeColor=#6c8ebf;" value="pymongo-api — N инстансов" vertex="1">
          <mxGeometry height="370" width="220" x="500" y="250" as="geometry" />
        </mxCell>
        <mxCell id="app1" parent="apps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;pymongo-api-1&lt;/b&gt;&lt;br&gt;:8080" vertex="1">
          <mxGeometry height="70" width="160" x="30" y="45" as="geometry" />
        </mxCell>
        <mxCell id="app2" parent="apps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;pymongo-api-2&lt;/b&gt;&lt;br&gt;:8080" vertex="1">
          <mxGeometry height="70" width="160" x="30" y="155" as="geometry" />
        </mxCell>
        <mxCell id="app3" parent="apps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;pymongo-api-3&lt;/b&gt;&lt;br&gt;:8080" vertex="1">
          <mxGeometry height="70" width="160" x="30" y="265" as="geometry" />
        </mxCell>
        <mxCell id="consul" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;Consul&lt;/b&gt;&lt;br&gt;Service Discovery&lt;br&gt;(каталог сервисов, health-check)&lt;br&gt;:8500" vertex="1">
          <mxGeometry height="90" width="220" x="360" y="80" as="geometry" />
        </mxCell>
        <mxCell id="u-gw" edge="1" parent="1" source="users" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" target="gw" value="HTTP-запросы">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gw-app1" edge="1" parent="1" source="gw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.25;exitDx=0;exitDy=0;strokeColor=#9673a6;" target="app1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gw-app2" edge="1" parent="1" source="gw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;strokeColor=#9673a6;" target="app2" value="балансировка">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gw-app3" edge="1" parent="1" source="gw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=1;exitY=0.75;exitDx=0;exitDy=0;strokeColor=#9673a6;" target="app3" value="">
          <mxGeometry relative="1" as="geometry" />
